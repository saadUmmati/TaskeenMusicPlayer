<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSong"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/ivAlbumArt"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_default_album"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Now Playing indicator -->
        <ImageView
            android:id="@+id/ivNowPlaying"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_equalizer"
            android:visibility="gone"
            app:tint="@color/accent"
            app:layout_constraintBottom_toBottomOf="@id/ivAlbumArt"
            app:layout_constraintEnd_toEndOf="@id/ivAlbumArt"
            app:layout_constraintStart_toStartOf="@id/ivAlbumArt"
            app:layout_constraintTop_toTopOf="@id/ivAlbumArt" />

        <!-- Song Info -->
        <LinearLayout
            android:id="@+id/llInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivAlbumArt"
            app:layout_constraintEnd_toStartOf="@id/tvDuration">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Duration -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:30"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ivMenu"
            app:layout_constraintEnd_toStartOf="@id/ivMenu" />

        <!-- Menu button -->
        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_more_vert"
            android:padding="2dp"
            app:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDuration"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
